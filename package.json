{
  "name": "vitals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "imports": {
    "#adapters": {
      "types": "./src/adapters/index.ts",
      "development": "./src/adapters/index.ts",
      "default": "./dist/adapters/index.js"
    },
    "#daemon": {
      "types": "./src/daemon/index.ts",
      "development": "./src/daemon/index.ts",
      "default": "./dist/daemon/index.js"
    },
    "#db": {
      "types": "./src/db/index.ts",
      "development": "./src/db/index.ts",
      "default": "./dist/db/index.js"
    },
    "#http": {
      "types": "./src/http/index.ts",
      "development": "./src/http/index.ts",
      "default": "./dist/http/index.js"
    },
    "#mcp": {
      "types": "./src/mcp/index.ts",
      "development": "./src/mcp/index.ts",
      "default": "./dist/mcp/index.js"
    },
    "#notifications": {
      "types": "./src/notifications/index.ts",
      "development": "./src/notifications/index.ts",
      "default": "./dist/notifications/index.js"
    },
    "#query": {
      "types": "./src/query/index.ts",
      "development": "./src/query/index.ts",
      "default": "./dist/query/index.js"
    },
    "#records": {
      "types": "./src/records/index.ts",
      "development": "./src/records/index.ts",
      "default": "./dist/records/index.js"
    },
    "#storage": {
      "types": "./src/storage/index.ts",
      "development": "./src/storage/index.ts",
      "default": "./dist/storage/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "dev:mcp": "tsx --conditions=development src/mcp/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp/server.js",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill": "tsx --conditions=development scripts/backfill-sqlite.ts",
    "connect:googlehealth": "tsx --conditions=development scripts/connect-googlehealth.ts",
    "connect:oura": "tsx --conditions=development scripts/connect-oura.ts",
    "db:generate": "drizzle-kit generate",
    "forbid-junk-object-types": "forbid-junk-object-types --target-dir .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run forbid-junk-object-types && pnpm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@hono/node-server": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.7.2",
    "hono": "^4.12.15",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-anvil": "^2.0.0",
    "forbid-junk-object-types": "^1.4.0",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
