{
  "name": "vitals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:mcp": "tsx src/mcp/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp/server.js",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "forbid-junk-object-types": "forbid-junk-object-types --target-dir .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run forbid-junk-object-types && pnpm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@hono/node-server": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.7.2",
    "hono": "^4.12.15",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-anvil": "^1.1.0",
    "forbid-junk-object-types": "^1.4.0",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
